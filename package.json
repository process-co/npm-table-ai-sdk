{
  "name": "@process.co/table-ai-sdk",
  "version": "0.1.1",
  "description": "Bounded AI SDK tools for the Process Table API",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "examples",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/process-co/npm-table-ai-sdk.git"
  },
  "keywords": [
    "process.co",
    "table",
    "ai-sdk",
    "agents",
    "tools"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@process.co/table-client": "^0.1.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "ai": "^6.0.0 || ^7.0.0"
  }
}
